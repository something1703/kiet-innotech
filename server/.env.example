# Production configuration for the InnoTech'26 API. Set these as environment variables (or AWS Secrets Manager / SSM).

ENVIRONMENT=production

# RDS PostgreSQL. Use SSL in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/innotech?sslmode=require

# Exact origins of the student portal and admin panel (no wildcards).
CORS_ORIGINS=https://innotech.kiet.edu,https://admin.innotech.kiet.edu

# Cognito user pool with Google as identity provider.
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
# App client IDs of the student portal and the admin panel (comma-separated).
COGNITO_CLIENT_IDS=xxxxxxxxxxxxxxxxxxxxxxxxxx,yyyyyyyyyyyyyyyyyyyyyyyyyy
# Keep both true. Map Google's email_verified attribute to Cognito's email_verified (see README).
REQUIRE_GOOGLE_IDENTITY=true
REQUIRE_EMAIL_VERIFIED=true

# Always super admins; they add the department admins from the admin panel.
SUPER_ADMIN_EMAILS=someone@kiet.edu

# Registration window (with timezone offset).
REGISTRATION_OPENS=2026-10-03T00:00:00+05:30
REGISTRATION_CLOSES=2026-10-12T23:59:59+05:30

# Invitation and submission emails through Amazon SES (the sender must be a verified identity).
EMAIL_BACKEND=ses
SES_REGION=ap-south-1
EMAIL_SENDER=InnoTech'26 <no-reply@innotech.kiet.edu>
PORTAL_URL=https://innotech.kiet.edu

INVITATIONS_PER_TEAM_PER_DAY=20
