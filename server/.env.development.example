# Copy to .env for local development against the local PostgreSQL. Never use these values in production.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg:///innotech_dev
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DEV_JWT_SECRET=local-development-secret-change-me-please
FORCE_REGISTRATION_OPEN=true
SUPER_ADMIN_EMAILS=superadmin@kiet.edu
EMAIL_BACKEND=log
