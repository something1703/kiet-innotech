# InnoTech'26 admin panel configuration. Copy to .env.local (or set in the hosting environment).

# "mock" (default) uses a seeded in-browser dataset stored in localStorage and a development sign-in picker.
# "live" talks to the FastAPI backend and signs in through Amazon Cognito (Google identity provider).
NEXT_PUBLIC_API_MODE=mock

# Base URL of the FastAPI backend, without a trailing slash. Required when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_URL=https://api.innotech.kiet.edu

# Cognito Hosted UI domain, without a trailing slash, e.g. https://innotech-admin.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
# App client ID of a public app client (no secret) with the authorization-code grant, PKCE and Google enabled.
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Must exactly match an allowed callback URL on the app client.
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3001/auth/callback
# Optional. Where Cognito sends the browser after sign-out. Defaults to <origin>/login.
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3001/login

# Optional. Pretend the registration window is open (shared with the student portal's rules.ts).
# NEXT_PUBLIC_FORCE_REGISTRATION_OPEN=true

# Local development only (with NEXT_PUBLIC_API_MODE=live): the demo picker signs in with the local backend's
# /dev/token instead of Google. Never set in production.
# NEXT_PUBLIC_DEV_SIGN_IN=true
