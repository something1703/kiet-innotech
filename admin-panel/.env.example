# InnoTech'26 admin panel configuration. Copy to .env.local (or set in the build environment).
# The panel is a static export: every NEXT_PUBLIC_* value is baked in when `npm run build` runs.

# "mock" uses a seeded in-browser dataset stored in localStorage and a development sign-in picker.
# Anything else, including leaving it unset, talks to the FastAPI backend and signs in with Google.
# A live production build fails if NEXT_PUBLIC_API_URL or NEXT_PUBLIC_GOOGLE_CLIENT_ID is empty.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the FastAPI backend, without a trailing slash. Required in live mode.
NEXT_PUBLIC_API_URL=https://api.innotech.kiet.edu

# Google OAuth client ID for "Sign in with Google" (Google Identity Services). Required in live mode.
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID →
# Application type "Web application". Under "Authorised JavaScript origins" add every origin the
# panel is served from, e.g. https://admin.innotech.kiet.edu and http://localhost:3001 (no redirect URIs
# are needed). The backend must accept the same client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Pretend the registration window is open (shared with the student portal's rules.ts).
# NEXT_PUBLIC_FORCE_REGISTRATION_OPEN=true

# Local development only (live mode): the demo picker signs in with the local backend's /dev/token
# instead of Google, and NEXT_PUBLIC_GOOGLE_CLIENT_ID is not needed. Never set in production.
# NEXT_PUBLIC_DEV_SIGN_IN=true
