# The practice sandbox: a second, separate deployment for demonstrations (copy to deploy/sandbox.env, git-ignored).
#
#   export DEPLOY_ENV=deploy/sandbox.env
#   ./deploy/deploy.sh stack && ./deploy/deploy.sh api && ./deploy/deploy.sh sites
#   ./deploy/deploy.sh destroy        # when it is no longer needed (asks you to type the stack name)
#
# It is its own CloudFormation stack, with its own server, database, backups bucket and image repository, so nothing in it
# can reach the real event. It is filled with made-up data (see server/app/services/sandbox.py).

AWS_PROFILE=default
AWS_ACCOUNT_ID=000000000000
AWS_REGION=ap-south-1

STACK_NAME=innotech-sandbox
INSTANCE_TYPE=t4g.small
WEB_CONCURRENCY=1

# Only needed to build the admin panel; the sandbox signs in with the access code, not Google.
GOOGLE_CLIENT_IDS=

# The people who can sign in (comma-separated). Those with a @kiet.edu email are also the room's judges.
SUPER_ADMIN_EMAILS=

SANDBOX_MODE=true
# At least 12 characters; share it only with the people who sign in.
SANDBOX_ACCESS_CODE=

# Registration must have closed, so scoring can open.
REGISTRATION_OPENS=2026-10-01T00:00:00+05:30
REGISTRATION_CLOSES=2026-10-15T23:59:59+05:30
# Made-up students: never send real emails.
EMAIL_BACKEND=log
