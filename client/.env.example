# "mock" uses an in-browser stand-in for the backend; "live" talks to FastAPI and Cognito.
NEXT_PUBLIC_API_MODE=live

# FastAPI base URL, e.g. https://api.innotech.kiet.edu
NEXT_PUBLIC_API_URL=

# Amazon Cognito user pool app client with Google as an identity provider.
# Domain is the Hosted UI domain, e.g. https://innotech.auth.ap-south-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Must be listed as an allowed callback URL on the app client, e.g. https://innotech.kiet.edu/auth/callback
NEXT_PUBLIC_COGNITO_REDIRECT_URI=

# Set to "true" only for testing, to allow registration outside 3 to 12 October 2026.
NEXT_PUBLIC_FORCE_REGISTRATION_OPEN=false

# Local development only: sign in with the local backend's /dev/token instead of Google. Never set in production.
NEXT_PUBLIC_DEV_SIGN_IN=false
